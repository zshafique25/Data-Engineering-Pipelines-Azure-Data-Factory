{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dfproadf-zain"
		},
		"ls_database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_database'"
		},
		"ls_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_datalake'"
		},
		"ls_Rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"ls_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dfproserver-zain.database.windows.net"
		},
		"ls_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dfprodb"
		},
		"ls_database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin-zain"
		},
		"ls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dfprostorage.dfs.core.windows.net/"
		},
		"schedule_properties_Scheduled_parameters_schema": {
			"type": "string",
			"defaultValue": "source"
		},
		"schedule_properties_Scheduled_parameters_table": {
			"type": "string",
			"defaultValue": "Orders"
		},
		"schedule_properties_Scheduled_Multitables_parameters_schema_name": {
			"type": "string",
			"defaultValue": "source"
		},
		"trigger2_properties_pipeline_parameters_windowstartertime": {
			"type": "string",
			"defaultValue": "@triggeroutputs().windowstartertime"
		},
		"trigger2_properties_pipeline_parameters_windowendtime": {
			"type": "string",
			"defaultValue": "@triggeroutputs().windowendtime"
		},
		"trigger_events_properties_Event_trigger_parameters_pl_param_foldername": {
			"type": "string",
			"defaultValue": "@triggerBody().folderPath"
		},
		"trigger_events_properties_Event_trigger_parameters_pl_param_filename": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"trigger_events_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/a7add2b6-7c77-4e76-a5f6-9d61f70d8119/resourceGroups/DataFactoryPro/providers/Microsoft.Storage/storageAccounts/dfprostorage"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dfproadf-zain_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_database_password": {
						"value": "[parameters('ls_database_password')]"
					},
					"ls_datalake_accountKey": {
						"value": "[parameters('ls_datalake_accountKey')]"
					},
					"ls_Rest_properties_typeProperties_url": {
						"value": "[parameters('ls_Rest_properties_typeProperties_url')]"
					},
					"ls_database_properties_typeProperties_server": {
						"value": "[parameters('ls_database_properties_typeProperties_server')]"
					},
					"ls_database_properties_typeProperties_database": {
						"value": "[parameters('ls_database_properties_typeProperties_database')]"
					},
					"ls_database_properties_typeProperties_userName": {
						"value": "[parameters('ls_database_properties_typeProperties_userName')]"
					},
					"ls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_datalake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "dfproadf-zain_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"trigger2_properties_pipeline_parameters_windowstartertime": {
						"value": "[parameters('trigger2_properties_pipeline_parameters_windowstartertime')]"
					},
					"trigger2_properties_pipeline_parameters_windowendtime": {
						"value": "[parameters('trigger2_properties_pipeline_parameters_windowendtime')]"
					},
					"trigger_events_properties_Event_trigger_parameters_pl_param_foldername": {
						"value": "[parameters('trigger_events_properties_Event_trigger_parameters_pl_param_foldername')]"
					},
					"trigger_events_properties_Event_trigger_parameters_pl_param_filename": {
						"value": "[parameters('trigger_events_properties_Event_trigger_parameters_pl_param_filename')]"
					},
					"trigger_events_properties_typeProperties_scope": {
						"value": "[parameters('trigger_events_properties_typeProperties_scope')]"
					},
					"schedule_properties_Scheduled_parameters_schema": {
						"value": "[parameters('schedule_properties_Scheduled_parameters_schema')]"
					},
					"schedule_properties_Scheduled_parameters_table": {
						"value": "[parameters('schedule_properties_Scheduled_parameters_table')]"
					},
					"schedule_properties_Scheduled_Multitables_parameters_schema_name": {
						"value": "[parameters('schedule_properties_Scheduled_Multitables_parameters_schema_name')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'dfproadf-zain_ArmTemplate_0')]"
			]
		}
	]
}